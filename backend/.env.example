# Copy this file to .env and fill in real values

DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/grocery_app
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OPTIONAL — leave these blank/absent to stay in test mode (OTP shows on
# screen instead of being emailed). Fill these in with your own Gmail
# address + an App Password (not your normal password — see app/auth.py
# for how to generate one) to send real OTP emails, for free.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
